# Build output — regenerated by `npm run build`, and `sw.js` inside it is
# generated from that build. Committing it would mean a stale worker could be
# deployed against fresh assets.
dist/
node_modules/

# NEVER COMMIT. Contains a PRIVATE KEY for the LAN HTTPS certs used to reach
# the app from a phone. These are local-development certs only; a deployed
# build uses the host's own TLS and needs nothing from here.
.certs/

# macOS
.DS_Store
*.log

# Local env
.env
.env.local
.vercel

# Tooling scratch — not part of the app
gitinit.mjs
commit.mjs
remote.mjs
push.mjs
commit2.mjs
addreadme.mjs
cleanup.mjs
.claude-launch-note
